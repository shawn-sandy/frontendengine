---
import Layout from '../layouts/Layout.astro'
import CollectionList from '#components/astro/CollectionList.astro'
import HomeHero from '#components/astro/HomeHero.astro'
import { SITE_DESCRIPTION, SITE_OG_IMAGE, SITE_TITLE } from '#utils/site-config.js'
---

<Layout
  pageTitle={SITE_TITLE}
  pageDescription={SITE_DESCRIPTION}
  showBreadcrumb={false}
  ogImageUrl={SITE_OG_IMAGE}
>
  <HomeHero slot="header" />
  <section class="home-latest" aria-labelledby="home-latest-title">
    <h2 class="home-section-title" id="home-latest-title">Latest posts</h2>
    <CollectionList pageSize={6} />
  </section>
</Layout>

<style>
  /* The hero's own padding sits inside its background band, so it buys no
     separation from the content below it. Spacing between the two belongs
     here, where they are composed. */
  .home-latest {
    margin-block-start: var(--space-8);
  }

  /* Section heading: title role with the shared hairline rule. */
  .home-section-title {
    border-block-end: 1px solid var(--rule);
    font-size: var(--font-size-3xl);
    margin-block: 0 var(--space-7);
    padding-block-end: var(--space-3);
  }

  /* Post titles come from BlogPosts, whose links take the vendor --h3 scale
     (48px at desktop) and outranked everything below the hero. On the
     homepage they are list items, so they take the size of the card titles. */
  .home-latest :global(h2 a[href]) {
    font-size: var(--font-size-xl);
  }

  /* `main > section` carries 2rem of inline padding, which set the post list
     32px in from the hero above it. This keeps the post list and the sidebar
     beside it on the hero's gutter: 1.25rem while the viewport is narrower
     than the measure, easing to 0 once main is centred with room to spare.
     Scoped through :has so it cannot reach another page's main. */
  :global(main:has(.home-latest) > section) {
    padding-inline: clamp(
      0rem,
      calc((var(--max-content-width, 80rem) + 2.5rem - 100vw) / 2),
      1.25rem
    );
  }

  @media (max-width: 60rem) {
    .home-section-title {
      font-size: var(--font-size-2xl);
    }
  }
</style>
